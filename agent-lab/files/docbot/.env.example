# Copy to .env:   cp .env.example .env     (never commit .env)

# Module 00 and up
ANTHROPIC_API_KEY=sk-ant-...

# Module 03 and up (console.voyageai.com)
VOYAGE_API_KEY=pa-...
DATABASE_URL=postgres://postgres:pw@localhost:5432/postgres
# store.js picks a vector database: pg, chroma or qdrant
VECTOR_DB=pg

# Module 06: Langfuse (cloud.langfuse.com, or your own Docker install)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Module 09: Mem0 (app.mem0.ai)
MEM0_API_KEY=m0-...

# Module 10: E2B sandboxes (e2b.dev)
E2B_API_KEY=e2b_...
