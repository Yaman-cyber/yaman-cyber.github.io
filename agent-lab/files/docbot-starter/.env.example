# Copy to .env.development:   cp .env.example .env.development
# then put your real API keys in. The other values match docker-compose.yml.

# microflame's own settings
PORT=3000
ENVIRONMENT=development
TEMPLATE_JWTPRIVATEKEY=change-me-to-a-long-random-string
DB_PROTOCOL=mongodb
DB_USERNAME=docbot
DB_PASSWORD=pw
DB_HOST=@localhost:27017
DB_NAME=docbot

# DocBot's settings (`microflame add-env` maps each one in config)
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
AI_MODEL=claude-sonnet-5-5
VECTOR_DATABASE_URL=postgres://postgres:pw@localhost:5432/postgres
HELPDESK_URL=https://your-helpdesk.example.com/api
HELPDESK_KEY=...
